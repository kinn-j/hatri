rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // A signed-in user can access only their own Hatri preferences.
    match /users/{userId}/preferences/{documentId} {
      allow read, delete: if request.auth != null
        && request.auth.uid == userId;

      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'core', 'filters', 'choices', 'ratings', 'updatedAt'
        ])
        && request.resource.data.core is map
        && request.resource.data.filters is map
        && request.resource.data.choices is map
        && request.resource.data.ratings is map;
    }
    match /users/{userId}/activityConsent/{clientId} {
      allow create, update: if request.auth != null && request.auth.uid == userId
        && clientId.matches('^[a-f0-9-]{36}$')
        && request.resource.data.keys().hasOnly(['enabled', 'updatedAt'])
        && request.resource.data.enabled is bool
        && request.resource.data.updatedAt == request.time;
    }
    // Only the trusted backend can publish, edit or remove a video.
    match /publicRecipeVideos/{videoId} {
      allow get: if resource.data.version == 2 && resource.data.status == 'published';
      allow list: if resource.data.version == 2 && resource.data.status == 'published'
        && request.query.limit <= 30;
    }
    match /reelDrafts/{videoId} {
      allow get: if request.auth != null && resource.data.ownerUid == request.auth.uid;
      allow list: if request.auth != null && resource.data.ownerUid == request.auth.uid
        && request.query.limit <= 30;
    }
    // All other paths are denied.

  }
}
